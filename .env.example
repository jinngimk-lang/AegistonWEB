# 复制为 .env 后按环境修改。生产必须替换 ADMIN_TOKEN 与 SECRET_SALT。
# 全部后端变量以 AEGISTON_ 为前缀（spec §11.1）。

# ---------- 后端（api） ----------
AEGISTON_ENV=dev

# 运行期使用**异步** URL
AEGISTON_DATABASE_URL=sqlite+aiosqlite:////data/aegiston.db
# Alembic 迁移使用**同步** URL。缺这一项容器首次启动执行迁移即失败（spec P1-13）。
# 留空时 Settings 会从上面的异步 URL 自动推导，两者永远指向同一个文件。
AEGISTON_SYNC_DATABASE_URL=sqlite:////data/aegiston.db

# 限流计数器存储。默认与 leads 同库，保证多 worker 共享计数；
# 未来引入 Redis 只需改这一个变量。
AEGISTON_RATELIMIT_STORAGE=

# 分层限流配额（spec §7.3.1）
AEGISTON_RATE_LIMIT_LEADS_IP=60/hour
AEGISTON_RATE_LIMIT_LEADS_CONTACT_HOUR=3
AEGISTON_RATE_LIMIT_LEADS_CONTACT_DAY=10
AEGISTON_LEAD_IDEMPOTENCY_WINDOW_SECONDS=600

AEGISTON_CORS_ORIGINS=http://localhost:3000

# ⚠️ 生产必须替换：≥ 32 字符随机串
AEGISTON_ADMIN_TOKEN=change-me-to-a-32-char-random-string
# ⚠️ 生产必须替换：IP 与联系方式 hash 的盐，泄露会让脱敏失效
AEGISTON_SECRET_SALT=change-me-to-a-random-salt

AEGISTON_LOG_LEVEL=INFO
AEGISTON_LOG_JSON=true
AEGISTON_METRICS_ENABLED=false

# gunicorn。v1 固定单 worker：官网 QPS 极低，同时消除限流计数器分裂与 SQLite 写竞争。
AEGISTON_WORKERS=1
AEGISTON_THREADS=4

# ---------- 前端（web） ----------
# 服务端 RSC 调用地址。容器内用服务名，本地开发用 127.0.0.1。
API_BASE_URL=http://127.0.0.1:8000
API_TIMEOUT_MS=3000
# 绝对 URL，用于 canonical / OpenGraph / sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
