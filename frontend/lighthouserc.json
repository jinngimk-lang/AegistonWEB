{
  "_note": "Lighthouse CI 配置（spec §12.4）。本轮**未在 CI 中实跑**，见 spec「实施过程发现的方案缺陷」D 组。要启用：npx @lhci/cli autorun --config=lighthouserc.json（需先 npm run build && npm run start）。SEO 不设 100 硬门禁：保持 categories:seo >= 0.95，并通过普通说明字段记录原因，不把说明伪装成 Lighthouse audit assertion。",
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3000/",
        "http://127.0.0.1:3000/products",
        "http://127.0.0.1:3000/products/aragonteam",
        "http://127.0.0.1:3000/solutions/telecom",
        "http://127.0.0.1:3000/research",
        "http://127.0.0.1:3000/contact"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],

        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }],

        "unused-javascript": "off",
        "uses-long-cache-ttl": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
