{
  "_note": "Lighthouse CI · 移动端（v3 spec §4.6.3）。desktop 配置见 lighthouserc.json。跑法：npm run lhci:mobile（需先 npm run build && npm run start）。@lhci/cli 版本锁在 0.14.x —— 版本浮动会因为新增审计项无故变红（v2 P2-11）。",
  "_why-085": "移动端 performance 定 0.85 而不是 0.90（决策 A-12）：首屏有一张大幅英雄图 + CJK 字体分片，在模拟 4G + 4× CPU 节流下要到 0.90 必须牺牲视觉（换成纯色首屏），与「顶级设计」目标冲突。0.85 是有依据的取舍，不是妥协的托词。若实测稳定高于 0.90，按 V3-3 上调并写明实测值。",
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3000/",
        "http://127.0.0.1:3000/products",
        "http://127.0.0.1:3000/products/legallens",
        "http://127.0.0.1:3000/solutions/telecom",
        "http://127.0.0.1:3000/insights/why-start-with-rd",
        "http://127.0.0.1:3000/search"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "mobile",
        "throttlingMethod": "simulate",
        "chromeFlags": "--force-prefers-reduced-motion"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],

        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 350 }],

        "unused-javascript": "off",
        "uses-long-cache-ttl": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
